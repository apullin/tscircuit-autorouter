+/**
+ * Struct-of-arrays node pool (mirrors A03's TypedNodePool): avoids one
+ * SearchNode object allocation per generated neighbor — millions per solve.
+ * `ripped` chain heads stay in a parallel plain array (object refs).
+ */
+class TypedSearchNodePool {
+  z = new Int32Array(1024)
+  row = new Int32Array(1024)
+  col = new Int32Array(1024)
+  g = new Float64Array(1024)
+  f = new Float64Array(1024)
+  parentIdx = new Int32Array(1024)
+  ripped: Array<RippedNode | null> = []
+  length = 0
+
+  clear() {
+    this.length = 0
+    this.ripped.length = 0
+  }
+
+  push(
+    z: number,
+    row: number,
+    col: number,
+    g: number,
+    f: number,
+    parentIdx: number,
+    ripped: RippedNode | null,
+  ): number {
+    this.ensureCapacity(this.length + 1)
+    const idx = this.length++
+    this.z[idx] = z
+    this.row[idx] = row
+    this.col[idx] = col
+    this.g[idx] = g
+    this.f[idx] = f
+    this.parentIdx[idx] = parentIdx
+    this.ripped[idx] = ripped
+    return idx
+  }
+
+  private ensureCapacity(size: number) {
+    if (size <= this.z.length) return
+    let next = this.z.length
+    while (next < size) next *= 2
+    const nz = new Int32Array(next); nz.set(this.z); this.z = nz
+    const nr = new Int32Array(next); nr.set(this.row); this.row = nr
+    const nc = new Int32Array(next); nc.set(this.col); this.col = nc
+    const ng = new Float64Array(next); ng.set(this.g); this.g = ng
+    const nf = new Float64Array(next); nf.set(this.f); this.f = nf
+    const np = new Int32Array(next); np.set(this.parentIdx); this.parentIdx = np
+  }
+}

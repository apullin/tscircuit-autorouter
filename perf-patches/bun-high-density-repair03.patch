+/**
+ * Env flags for incremental (delta) DRC candidate evaluation — design doc
+ * perf-artifacts/incremental-drc-design.md §3 D1.
+ *
+ * TS_INCREMENTAL_DRC=1
+ *   Enables delta screening of repair candidates: when the configured
+ *   drcEvaluator implements evaluateCandidateDelta, candidate snapshots are
+ *   screened via a pruned-input evaluation of only the dirty routes'
+ *   neighborhoods. Candidates that pass the screen trigger ONE full snapshot
+ *   before acceptance (the full snapshot stays the authority for the actual
+ *   accept decision and becomes the new comparison base, preserving error
+ *   ordering for the targeting cursors). Default OFF: with the flag unset
+ *   every code path below is a dead branch and behavior is byte-identical
+ *   to before.
+ *
+ * TS_INCREMENTAL_DRC_VERIFY=1 (requires TS_INCREMENTAL_DRC=1)
+ *   Computes BOTH the delta aggregates and the full snapshot per screened
+ *   candidate, asserts (count, issueScore, viaIssueCount) equality and
+ *   decision agreement, and throws with full context on mismatch. Decisions
+ *   in verify mode always come from the full snapshot, so a verify run
+ *   makes exactly the same accept/reject choices as a flag-off run.
+ */
+export const INCREMENTAL_DRC_ENABLED =
+  typeof process !== "undefined" && process.env?.TS_INCREMENTAL_DRC === "1"
+
+export const INCREMENTAL_DRC_VERIFY =
+  INCREMENTAL_DRC_ENABLED &&
+  typeof process !== "undefined" &&
+  process.env?.TS_INCREMENTAL_DRC_VERIFY === "1"
+
+/**
+ * issueScore is a float sum of per-error severities; summation order differs
+ * between the full path (error-list order) and the delta path (base score
+ * minus removed plus added). Aggregate differences at or below this
+ * tolerance with equal counts are floating-point summation noise, not logic
+ * errors; verify mode counts them separately and still throws if the
+ * accept/reject decision could differ.
+ */
+export const INCREMENTAL_DRC_SCORE_NOISE_TOLERANCE = 1e-6

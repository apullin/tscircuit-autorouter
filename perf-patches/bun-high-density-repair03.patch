+/**
+ * Pre-resolves an obstacle's connected ids and their net ids into a Set so
+ * hot loops (obstacle x via/segment pairs) pay one Set probe per pair
+ * instead of walking connectedTo with connMap lookups per string.
+ */
+export const createObstacleNetMatcher = (
+  obstacle: SimpleRouteJson["obstacles"][number],
+  connMap?: ConnectivityMap,
+) => {
+  const connectedIds = new Set<string>()
+  for (const connectedTo of obstacle.connectedTo ?? []) {
+    if (!connectedTo) continue
+    connectedIds.add(connectedTo)
+    const netId = getConnMapNetId(connMap, connectedTo)
+    if (netId) connectedIds.add(netId)
+  }
+  return (rootConnectionName: string): boolean => {
+    if (connectedIds.has(rootConnectionName)) return true
+    const rootNetId = getConnMapNetId(connMap, rootConnectionName)
+    return rootNetId !== undefined && connectedIds.has(rootNetId)
+  }
+}

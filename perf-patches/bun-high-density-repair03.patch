+/**
+ * Env-gated DRC evaluation instrumentation (TS_DRC_EVAL_STATS=1).
+ *
+ * Counts every getDrcSnapshot invocation by call-site tag and accumulates
+ * wall-clock ms for the expensive sub-steps. When the env var is unset,
+ * DRC_EVAL_STATS_ENABLED is a module-level constant `false`, so every
+ * instrumented site costs a single dead branch — no timers, no allocation.
+ *
+ * The store is a process-global module singleton. The repo-side evaluator
+ * code (lib/testing/getDrcErrors.ts etc.) imports this same module so all
+ * counters land in one place the benchmark probe can print. Worker threads
+ * (A2 branch workers, replay workers) get their own module instance; their
+ * counts are NOT merged into the parent. Benchmark mode (TS_BENCHMARK=1)
+ * runs the sequential path, which is where these numbers are read.
+ *
+ * Call-site tags for snapshot counts (design doc incremental-drc-design.md
+ * §1.2): boundary.* (portfolio), initial / detour / terminal-via /
+ * via-in-pad / layer-move / sweep / force / broad-fallback / final /
+ * relaxation (inner solver). Inner-solver tags are prefixed "internal."
+ * when the solver has no drcEvaluator (the earlier globalDrcForceImproveSolver
+ * pipeline stage that scores via the package-internal 3-check DRC).
+ */
+export const DRC_EVAL_STATS_ENABLED =
+  typeof process !== "undefined" && process.env?.TS_DRC_EVAL_STATS === "1"
+
+export type DrcEvalStats = {
+  counts: Record<string, number>
+  ms: Record<string, number>
+}
+
+export const drcEvalStats: DrcEvalStats = { counts: {}, ms: {} }
+
+export const noteDrcEval = (tag: string): void => {
+  drcEvalStats.counts[tag] = (drcEvalStats.counts[tag] ?? 0) + 1
+}
+
+export const noteDrcEvalMs = (tag: string, ms: number): void => {
+  drcEvalStats.ms[tag] = (drcEvalStats.ms[tag] ?? 0) + ms
+}
+
+export const resetDrcEvalStats = (): void => {
+  drcEvalStats.counts = {}
+  drcEvalStats.ms = {}
+}
+
+/** Copy for JSON printing: counts verbatim, ms rounded to 0.1. */
+export const getDrcEvalStatsSummary = (): DrcEvalStats => ({
+  counts: { ...drcEvalStats.counts },
+  ms: Object.fromEntries(
+    Object.entries(drcEvalStats.ms).map(([tag, ms]) => [tag, +ms.toFixed(1)]),
+  ),
+})

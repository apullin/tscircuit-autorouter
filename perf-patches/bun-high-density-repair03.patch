+}
+
+export const evaluateDrcCandidate = (
+  params: EvaluateDrcCandidateParams,
+): DrcCandidateEvaluation => {
+  const { srj, candidateRoutes, drcEvaluator, connMap, base } = params
+  const evaluateFull = (): DrcCandidateEvaluation => {
+    const snapshot = getDrcSnapshot(srj, candidateRoutes, drcEvaluator, connMap)
+    return {
+      snapshot,
+      count: snapshot.count,
+      issueScore: snapshot.issueScore,
+      viaIssueCount: getViaDrcIssueCount(snapshot),
+    }
+  }
+  const evaluateCandidateDelta = INCREMENTAL_DRC_ENABLED
+    ? drcEvaluator?.evaluateCandidateDelta
+    : undefined
+  if (!evaluateCandidateDelta) return evaluateFull()
+
+  const dirtyRouteIndexes = getDirtyRouteIndexes(base.routes, candidateRoutes)
+  let deltaAggregates: DrcCandidateDeltaAggregates | undefined
+  if (dirtyRouteIndexes !== undefined) {
+    if (dirtyRouteIndexes.length === 0) {
+      // Geometrically identical to the base: a full eval would reproduce the
+      // base snapshot exactly (the evaluation is a deterministic function of
+      // route geometry and route-invariant inputs).
+      deltaAggregates = {
+        count: base.snapshot.count,
+        issueScore: base.snapshot.issueScore,
+        viaIssueCount: base.viaIssueCount,
+      }
+    } else {
+      deltaAggregates = evaluateCandidateDelta({
+        srj,
+        routes: candidateRoutes,
+        baseRoutes: base.routes,
+        baseErrors: base.snapshot.errors,
+        baseCount: base.snapshot.count,
+        baseIssueScore: base.snapshot.issueScore,
+        baseViaIssueCount: base.viaIssueCount,
+        dirtyRouteIndexes,
+      })
+    }
+  }
+  if (!deltaAggregates) {
+    noteDrcEval("incremental.screenFallback")
+    return evaluateFull()
+  }
+  if (INCREMENTAL_DRC_VERIFY) {
+    noteDrcEval("incremental.screen")
+    const fullEvaluation = evaluateFull()
+    verifyDeltaAggregates(
+      deltaAggregates,
+      fullEvaluation,
+      params,
+      dirtyRouteIndexes!,
+    )
+    // Verify mode decides from the full snapshot — identical to flag-off.
+    return fullEvaluation
+  }
+  if (DRC_EVAL_STATS_ENABLED) noteDrcEval("incremental.screen")
+  return deltaAggregates
+}
+
+/**
+ * Materializes the full snapshot for a candidate that passed the screen.
+ * When the evaluation already carries a snapshot (flag off / fallback /
+ * verify) this is free and returns the exact same values.
+ */
+export const resolveCandidateSnapshot = (
+  params: Pick<
+    EvaluateDrcCandidateParams,
+    "srj" | "candidateRoutes" | "drcEvaluator" | "connMap"
+  >,
+  evaluation: DrcCandidateEvaluation,
+): { snapshot: DrcSnapshot; viaIssueCount: number } => {
+  if (evaluation.snapshot) {
+    return {
+      snapshot: evaluation.snapshot,
+      viaIssueCount: evaluation.viaIssueCount,
+    }
+  }
+  if (DRC_EVAL_STATS_ENABLED) noteDrcEval("incremental.acceptFullEval")
+  const snapshot = getDrcSnapshot(
+    params.srj,
+    params.candidateRoutes,
+    params.drcEvaluator,
+    params.connMap,
+  )
+  return { snapshot, viaIssueCount: getViaDrcIssueCount(snapshot) }
+}

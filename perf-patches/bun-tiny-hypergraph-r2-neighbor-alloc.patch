diff --git a/tests/indexed-candidate-heap.test.ts b/tests/indexed-candidate-heap.test.ts
index 3b8981d5..154ed1d5 100644
--- a/tests/indexed-candidate-heap.test.ts
+++ b/tests/indexed-candidate-heap.test.ts
@@ -15,8 +15,15 @@ const candidate = (params: {
   h: params.f - params.g,
 })
 
+// Every port has exactly two incident regions (loader invariant); the test
+// topology gives ports 1 and 2 incident region 2 on side 0.
+const incidentPortRegion: number[][] = Array.from({ length: 10 }, (_, i) => [
+  2,
+  100 + i,
+])
+
 test("keeps the lowest-cost queued directed hop and closes dequeued hops", () => {
-  const heap = new IndexedCandidateHeap(10)
+  const heap = new IndexedCandidateHeap(10, incidentPortRegion)
   const firstHop = candidate({ portId: 1, nextRegionId: 2, g: 10, f: 10 })
   const worseFirstHop = candidate({ portId: 1, nextRegionId: 2, g: 11, f: 1 })
   const betterFirstHop = candidate({ portId: 1, nextRegionId: 2, g: 5, f: 20 })
@@ -39,3 +46,62 @@ test("keeps the lowest-cost queued directed hop and closes dequeued hops", () =>
   heap.queue(secondHop)
   expect(heap.toArray()).toEqual([secondHop])
 })
+
+test("queueFields materializes an equivalent candidate on dequeue", () => {
+  const heap = new IndexedCandidateHeap(10, incidentPortRegion)
+  const parent: Candidate = {
+    portId: 0,
+    nextRegionId: 2,
+    g: 0,
+    h: 0,
+    f: 0,
+  }
+
+  heap.queueFields(
+    /* hopId */ 1 * 2,
+    /* portId */ 1,
+    /* nextRegionId */ 2,
+    /* prevRegionId */ 2,
+    /* g */ 3,
+    /* h */ 4,
+    parent,
+  )
+  expect(heap.length).toBe(1)
+
+  const dequeued = heap.dequeue()
+  expect(dequeued).toEqual({
+    prevRegionId: 2,
+    portId: 1,
+    nextRegionId: 2,
+    prevCandidate: parent,
+    f: 7,
+    g: 3,
+    h: 4,
+    hopId: 2,
+  })
+  expect(dequeued?.prevCandidate).toBe(parent)
+  expect(heap.dequeue()).toBeUndefined()
+})
+
+test("queueFields replacement keeps the better g like the object path", () => {
+  const heap = new IndexedCandidateHeap(10, incidentPortRegion)
+  const parent: Candidate = {
+    portId: 0,
+    nextRegionId: 2,
+    g: 0,
+    h: 0,
+    f: 0,
+  }
+  const queueHop = (g: number, h: number) =>
+    heap.queueFields(2, 1, 2, 2, g, h, parent)
+
+  queueHop(10, 0)
+  queueHop(11, 0) // worse g: rejected
+  expect(heap.length).toBe(1)
+  queueHop(5, 0) // better g: replaces in place
+  expect(heap.length).toBe(1)
+
+  const dequeued = heap.dequeue()
+  expect(dequeued?.g).toBe(5)
+  expect(dequeued?.f).toBe(5)
+})
